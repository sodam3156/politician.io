{
  "name": "politician-io",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "predev": "node scripts/prepare-data.mjs && node scripts/prepare-fonts.mjs",
    "dev": "vite --host 127.0.0.1 --port 8770 --strictPort",
    "prebuild": "node scripts/prepare-data.mjs && node scripts/prepare-fonts.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8770 --strictPort",
    "typecheck": "tsc --noEmit",
    "sync:assembly": "node scripts/sync-assembly.mjs",
    "audit:public": "node scripts/audit-public.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
