# Public source allowlist; private history and collected snapshots stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/DATA_SOURCES.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/src/
/src/*
!/src/main.tsx
!/src/PoliticianApp.tsx
!/src/politics.ts
!/src/politics-reviewed.ts
!/src/politics-demo.ts
!/src/politics.test.ts
!/src/styles.css
!/src/politicians.css
!/scripts/
/scripts/*
!/scripts/assembly-client.mjs
!/scripts/assembly-client.test.mjs
!/scripts/sync-assembly.mjs
!/scripts/sync-secure.ps1
!/scripts/prepare-data.mjs
!/scripts/prepare-fonts.mjs
!/scripts/audit-public.mjs
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
